#!/usr/bin/env bash

if [ ! -z "${RABBITMQ_BOOTSTRAP}" ]; then
    if [ ! -f /var/lib/rabbitmq/.lock ]; then
        export LC_ALL=C.UTF-8
        /usr/lib/rabbitmq/bin/rabbitmq-plugins enable --offline rabbitmq_management
        /usr/lib/rabbitmq/bin/rabbitmq-plugins enable --offline rabbitmq_auth_backend_ldap
        /usr/lib/rabbitmq/bin/rabbitmq-plugins enable --offline rabbitmq_prometheus
        touch /var/lib/rabbitmq/.lock
    fi
fi
