#!/usr/bin/env bash

sleep 10

if [ -z "${RABBITMQ_USERNAME}"]; then
    export RABBITMQ_USERNAME=root
fi

if [ -z "${RABBITMQ_PASSWORD}"]; then
    export RABBITMQ_PASSWORD=$(cat /proc/sys/kernel/random/uuid)
    export PASSWORD_RANDOM=true
fi

if [ ! -f /var/lib/rabbitmq/.pass ]; then
    export LC_ALL=C.UTF-8
    if [ ! -z "${PASSWORD_RANDOM}"]; then
        printf ${RABBITMQ_PASSWORD} > /var/lib/rabbitmq/.pass
    fi
    /usr/lib/rabbitmq/bin/rabbitmqctl add_user ${RABBITMQ_USERNAME} ${RABBITMQ_PASSWORD}
    /usr/lib/rabbitmq/bin/rabbitmqctl set_permissions -p "/" ${RABBITMQ_USERNAME} ".*" ".*" ".*"
    /usr/lib/rabbitmq/bin/rabbitmqctl set_user_tags ${RABBITMQ_USERNAME} administrator
    if [ ! -z "${RABBITMQ_DROP_GUEST}"]; then
        /usr/lib/rabbitmq/bin/rabbitmqctl delete_user guest
    fi
    touch /var/lib/rabbitmq/.pass
fi
