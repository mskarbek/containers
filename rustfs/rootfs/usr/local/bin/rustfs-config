#!/usr/bin/env bash

echo "INFO: Configuring RustFS"
mkdir -p /var/log/rustfs

if [ ! -f /etc/sysconfig/rustfs ]; then
    echo "INFO: Copying default config file"
    cp /usr/share/rustfs/rustfs /etc/sysconfig/rustfs
    echo "RUSTFS_ACCESS_KEY=$(openssl rand -hex 26)" >> /etc/sysconfig/rustfs
    echo "RUSTFS_SECRET_KEY=$(openssl rand -hex 64)" >> /etc/sysconfig/rustfs
fi
