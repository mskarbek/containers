ARG BASE_IMAGES_REPO

FROM ${BASE_IMAGES_REPO}/ubi10-minimal:latest

COPY rootfs/ /

RUN <<EOF
    set -euxo pipefail
    microdnf -y install unzip openssl tar gzip
    microdnf clean all
    curl -Lo /tmp/rustfs.zip https://repo.skarbek.name/repository/p-raw-github/rustfs/rustfs/releases/download/1.0.0-beta.12/rustfs-linux-x86_64-gnu-latest.zip
    unzip -d /usr/local/bin/ /tmp/rustfs.zip
    rm /tmp/rustfs.zip
    chmod 0755 /usr/local/bin/rustfs
    cd /usr/local/bin
    curl -L https://repo.skarbek.name/repository/p-raw-github/rustfs/cli/releases/download/v0.1.30/rustfs-cli-linux-amd64-gnu-v0.1.30.tar.gz|tar xz
    chmod 0755 /usr/local/bin/rc
EOF

VOLUME /var/lib/rustfs
