FROM repo.skarbek.name/h-con-infra/ubi10:10.2

COPY rootfs/ /

RUN <<EOF
    dnf -y install unzip openssl
    dnf clean all
    curl -Lo /tmp/rustfs.zip https://repo.skarbek.name/repository/h-raw-infra/rustfs/1.0.0-beta.6/rustfs.zip
    unzip -d /usr/local/bin/ /tmp/rustfs.zip
    rm /tmp/rustfs.zip
    chmod 0755 /usr/local/bin/rustfs
    cd /usr/local/bin
    curl -L https://repo.skarbek.name/repository/h-raw-infra/rustfs-cli/0.1.18/rustfs-cli.tar.gz|tar xz
    chmod 0755 /usr/local/bin/rc
EOF

CMD ["/usr/bin/dinit", "--container"]

VOLUME /var/lib/rustfs
