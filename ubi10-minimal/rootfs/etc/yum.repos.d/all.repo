[rhel-10-for-$basearch-baseos-rpms]
name = Red Hat Enterprise Linux 10 for $basearch - BaseOS (RPMs)
baseurl = https://repo.skarbek.name/repository/p-rpm-redhat/dist/rhel10/$releasever/$basearch/baseos/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
metadata_expire = 24h

[rhel-10-for-$basearch-appstream-rpms]
name = Red Hat Enterprise Linux 10 for $basearch - AppStream (RPMs)
baseurl = https://repo.skarbek.name/repository/p-rpm-redhat/dist/rhel10/$releasever/$basearch/appstream/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
metadata_expire = 24h

[codeready-builder-for-rhel-10-$basearch-rpms]
name = Red Hat CodeReady Linux Builder for RHEL 10 $basearch (RPMs)
baseurl = https://repo.skarbek.name/repository/p-rpm-redhat/dist/rhel10/$releasever/$basearch/codeready-builder/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
metadata_expire = 24h

[epel]
name = Extra Packages for Enterprise Linux $releasever - $basearch
baseurl = https://repo.skarbek.name/repository/p-rpm-epel/$releasever${releasever_minor:+z}/Everything/$basearch/
enabled = 1
gpgcheck = 1
gpgkey = https://repo.skarbek.name/repository/p-rpm-epel/RPM-GPG-KEY-EPEL-$releasever_major
metadata_expire = 24h

[epel-multimedia]
name = negativo17 - Multimedia
baseurl = https://repo.skarbek.name/repository/p-rpm-negativo17/multimedia/epel-$releasever/$basearch/
enabled = 1
gpgcheck = 1
gpgkey = https://repo.skarbek.name/repository/p-rpm-negativo17/RPM-GPG-KEY-slaanesh
metadata_expire = 24h

[rpmfusion-free-updates]
name = RPM Fusion for EL 10 - Free - Updates
baseurl = https://repo.skarbek.name/repository/p-rpm-rpmfusion/free/el/updates/10/$basearch/
enabled = 0
gpgcheck = 1
gpgkey = https://repo.skarbek.name/repository/p-rpm-rpmfusion/free/el/RPM-GPG-KEY-rpmfusion-free-el-10
metadata_expire = 24h

[rpmfusion-nonfree-updates]
name = RPM Fusion for EL 10 - Nonfree - Updates
baseurl = https://repo.skarbek.name/repository/p-rpm-rpmfusion/nonfree/el/updates/10/$basearch/
enabled = 0
gpgcheck = 1
gpgkey = https://repo.skarbek.name/repository/p-rpm-rpmfusion/nonfree/el/RPM-GPG-KEY-rpmfusion-nonfree-el-10
metadata_expire = 24h

[infra]
name = Infra Packages for Enterprise Linux $releasever - $basearch
baseurl = https://repo.skarbek.name/repository/h-rpm-infra/$releasever/
enabled = 1
gpgcheck = 0
metadata_expire = 24h
